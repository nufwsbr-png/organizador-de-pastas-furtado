# Chave da API do ElevenLabs (Speech-to-Text). Sem ela o app organiza a pasta,
# mas não transcreve o áudio nem preenche a entrevista.
ELEVENLABS_API_KEY=

# Token da API do ZapSign (a conta precisa do Plano de API). Sem ele o app não puxa
# a procuração, a declaração e o contrato assinados.
ZAPSIGN_API_TOKEN=

# Chave da API do WAHA (WhatsApp do escritório), só de leitura da sessão "furtado". O endereço e a sessão ficam em Ajustes.
# Sem ela o app não puxa os documentos que o cliente mandou no WhatsApp.
WAHA_API_KEY=

# Só para quem administra o WAHA (criar a sessão, gerar chaves). O app não usa.
WAHA_ADMIN_API_KEY=

# Conta de serviço do Google (o JSON baixado no Google Cloud, em base64), que marca "Pasta pronta"
# na planilha. Em Ajustes, o botão "Escolher o arquivo da conta de serviço" preenche esta linha.
# A planilha precisa estar compartilhada com o e-mail da conta como Editor. O link da planilha fica em Ajustes.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
